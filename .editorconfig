# https://editorconfig.org

root = true

[*]
charset = utf-8
indent_style = space
end_of_line = lf
trim_trailing_whitespace = true

[*.{js,ts}]
indent_size = 2
insert_final_newline = true

[*.json]
indent_size = 2

[*.md]
insert_final_newline = false
trim_trailing_whitespace = false